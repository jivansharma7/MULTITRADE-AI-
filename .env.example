# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Solana RPC & Indexing Providers (defaults to public Solana Mainnet-Beta RPC if unset)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
HELIUS_API_KEY=""
BIRDEYE_API_KEY=""

# Optional Social Data Providers (displays connection setup instructions when unset)
TWITTER_BEARER_TOKEN=""
TELEGRAM_BOT_TOKEN=""
DISCORD_BOT_TOKEN=""

# Optional Billing Provider (Stripe checkout remains disabled until configured)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
